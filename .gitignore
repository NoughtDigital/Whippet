.DS_store

# ignore node dependency directories
node_modules/

# ignore PHP dependencies (Composer)
/vendor/

# ignore PHPUnit cache
.phpunit.result.cache

# ignore dist build junk but keep shipped CSS/JS artefacts
dist/*
!dist/css/
!dist/css/**
!dist/js/
!dist/js/**
!dist/mix-manifest.json
!dist/img/
!dist/img/**
